      <column caption='Install var %' datatype='real' name='[CTR var %(복사본)_6740199848489000981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;This Week&apos; THEN &#10;    ((&#10;       SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= DateTrunc(&apos;week&apos;, [Calculation_2295287747341398018]) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= [Calculation_2295287747341398018] THEN [install] END)&#10;        / SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= DateTrunc(&apos;week&apos;, [Calculation_2295287747341398018]) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= [Calculation_2295287747341398018] THEN [Clicks] END)&#10;    )&#10;    - &#10;    (&#10;       SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= Dateadd(&quot;day&quot;, -7, DATETRUNC(&quot;week&quot;,[Calculation_2295287747341398018])) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-7) THEN [install] END)&#10;        / SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= Dateadd(&quot;day&quot;, -7, DATETRUNC(&quot;week&quot;,[Calculation_2295287747341398018])) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-7) THEN [Clicks] END)&#10;    ))&#10;/ (&#10;       SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= Dateadd(&quot;day&quot;, -7, DATETRUNC(&quot;week&quot;,[Calculation_2295287747341398018])) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-7) THEN [install] END)&#10;        / SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= Dateadd(&quot;day&quot;, -7, DATETRUNC(&quot;week&quot;,[Calculation_2295287747341398018])) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-7) THEN [Clicks] END)&#10;    )&#10;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;Last 7 days&apos; THEN &#10;    ((&#10;        SUM(IF DateTrunc(&apos;day&apos;, [Date]) &gt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-6) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= [Calcula