k&apos;, [Date]) &lt;= [Calculation_2295287747341398018] THEN [install] END) &#10;        / SUM(IF DateTrunc(&apos;week&apos;, [Date]) &gt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-89) AND DateTrunc(&apos;week&apos;, [Date]) &lt;= [Calculation_2295287747341398018] THEN [Clicks] END) &#10;    )&#10;    - &#10;    (&#10;        SUM(IF DateTrunc(&apos;week&apos;, [Date]) &gt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-179) AND DateTrunc(&apos;week&apos;, [Date]) &lt;= [Calculation_2295287747341398018]-90 THEN [install] END) &#10;        / SUM(IF DateTrunc(&apos;week&apos;, [Date]) &gt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-179) AND DateTrunc(&apos;week&apos;, [Date]) &lt;= [Calculation_2295287747341398018]-90 THEN [Clicks] END) &#10;    ))&#10;/  (&#10;        SUM(IF DateTrunc(&apos;week&apos;, [Date]) &gt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-179) AND DateTrunc(&apos;week&apos;, [Date]) &lt;= [Calculation_2295287747341398018]-90 THEN [install] END) &#10;        / SUM(IF DateTrunc(&apos;week&apos;, [Date]) &gt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-179) AND DateTrunc(&apos;week&apos;, [Date]) &lt;= [Calculation_2295287747341398018]-90 THEN [Clicks] END) &#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
