          <datasource-dependencies datasource='federated.16y6kyd0cmjcnr13eoytx0az5eou'>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_2295287747325599745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[매개 변수 1]&#10;When &apos;This Week&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;week&apos;,[Calculation_2295287747341398018]) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;When &apos;Last Week&apos; Then DateTrunc(&apos;day&apos;, [Date]) &gt;= Dateadd(&quot;day&quot;, -7, DATETRUNC(&quot;week&quot;,[Calculation_2295287747341398018])) AND DateTrunc(&apos;day&apos;, [Date]) &lt;= DateTrunc(&apos;day&apos;, [Calculation_2295287747341398018]-7)&#10;&#10;When &apos;Last 7 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-6) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;WHEN &apos;Previous 7 days&apos; Then DATETRUNC(&apos;day&apos;,[Date]) &gt;= DATETRUNC(&apos;day&apos;,[Calculation_2295287747341398018]-13 ) and DATETRUNC(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]-7 &#10;&#10;When &apos;Last 14 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-13) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;When &apos;Previous 14 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-27) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]-14&#10;&#10;When &apos;Last 28 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-27) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;When &apos;Pervious 28 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-55) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]-28&#10;&#10;When &apos;Last 30 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-29) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;When &apos;Pervious 30 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-59) and DateTrunc(&apos;day&apos;,[Date]) &lt;= [Calculation_2295287747341398018]-30&#10;&#10;When &apos;Last 90 days&apos; Then DateTrunc(&apos;week&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-89) and DateTrunc(&apos;week&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;When &apos;Pervious 90 days&apos; Then DateTrunc(&apos;week&apos;,[Date]) &gt;= DateTrunc(&apos;day&apos;,[Calculation_2295287747341398018]-179) and DateTrunc(&apos;week&apos;,[Date]) &lt;= [Calculation_2295287747341398018]-90&#10;&#10;When &apos;This Year&apos; Then DATETRUNC(&apos;month&apos;,[Date])&gt;= DateTrunc(&apos;year&apos;,[Calculation_2295287747341398018]) and DateTrunc(&apos;month&apos;,[Date]) &lt;= [Calculation_2295287747341398018]&#10;End' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_2295287747341398018]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX([Date])}' />
            </column>
            <column caption='Date Period' datatype='date' datatype-customized='true' name='[Calculation_2295287747365683223]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(Case [Parameters].[매개 변수 1]&#10;When &apos;This Week&apos; Then DateTrunc(&apos;day&apos;,[Date])&#10;When &apos;Last 7 days&apos; Then DateTrunc(&apos;day&apos;,[Date])&#10;When &apos;Last 14 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &#10;When &apos;Last 28 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &#10;When &apos;Last 30 days&apos; Then DateTrunc(&apos;day&apos;,[Date]) &#10;When &apos;Last 90 days&apos; Then DateTrunc(&apos;week&apos;,[Date]) &#10;When &apos;This Year&apos; Then DATETRUNC(&apos;month&apos;,[Date])&#10;End)' />
            </column>
            <column caption='Signup CVR' datatype='real' name='[Calculation_2295287751101972590]' role='measure' type='quantitative'>
